# DeepSeek API (tương thích OpenAI)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Tên model đúng như trong tài liệu DeepSeek của bạn
DEEPSEEK_MODEL=deepseek-chat

# Chuỗi ngẫu nhiên dài để ký session: openssl rand -base64 32
AUTH_SECRET=change-me

# Postgres (trên Vercel: thêm Prisma Postgres, biến này được tự điền)
DATABASE_URL="postgresql://user:password@localhost:5432/ai_therapist"
